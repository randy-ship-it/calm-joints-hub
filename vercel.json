{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/sms",
      "destination": "/api/qr-lead?kind=sms"
    },
    {
      "source": "/p/:slug",
      "destination": "/p?slug=:slug"
    }
  ],
  "crons": [
    {
      "path": "/api/partner-events",
      "schedule": "17 14 * * *"
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "lib/**"
    },
    "api/qr-lead.js": {
      "maxDuration": 30,
      "includeFiles": "lib/**"
    }
  },
  "routes": [
    { "src": "/lib(/.*)?", "status": 404 },
    { "src": "/scripts(/.*)?", "status": 404 },
    { "src": "/.*\\.md", "status": 404 },
    { "src": "/package(-lock)?\\.json", "status": 404 },
    { "src": "/vercel\\.json", "status": 404 },
    { "src": "/\\..*", "status": 404 },
    { "src": "/(br-loc-desk|hero-loc-desk)\\.png", "status": 404 }
  ]
}
