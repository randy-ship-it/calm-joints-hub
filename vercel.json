{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/sms",
      "destination": "/api/qr-lead?kind=sms"
    },
    {
      "source": "/p/:slug",
      "destination": "/p?slug=:slug"
    }
  ],
  "crons": [
    {
      "path": "/api/partner-events",
      "schedule": "17 14 * * *"
    }
  ],
  "functions": {
    "api/apply.js": { "includeFiles": "lib/**" },
    "api/careers.js": { "includeFiles": "lib/**" },
    "api/cj-sales.js": { "includeFiles": "lib/**" },
    "api/intake.js": { "includeFiles": "lib/**" },
    "api/newsletter.js": { "includeFiles": "lib/**" },
    "api/partner-events.js": { "includeFiles": "lib/**" },
    "api/partner-portal.js": { "includeFiles": "lib/**" },
    "api/partner.js": { "includeFiles": "lib/**" },
    "api/qr-lead.js": { "maxDuration": 30, "includeFiles": "lib/**" },
    "api/qr-partner.js": { "includeFiles": "lib/**" },
    "api/question.js": { "includeFiles": "lib/**" },
    "api/resume.js": { "includeFiles": "lib/**" }
  },
  "routes": [
    { "src": "/chat/?", "has": [{ "type": "query", "key": "guide", "value": "glen" }], "dest": "/chat-glen" },
    { "src": "/chat/?", "has": [{ "type": "query", "key": "guide", "value": "gwen" }], "dest": "/chat-gwen" },
    { "src": "/glen/?", "dest": "/chat-glen" },
    { "src": "/gwen/?", "dest": "/chat-gwen" },
    { "src": "/lib(/.*)?", "dest": "/api/blocked", "status": 404 },
    { "src": "/scripts(/.*)?", "dest": "/api/blocked", "status": 404 },
    { "src": "/.*\\.md", "dest": "/api/blocked", "status": 404 },
    { "src": "/package(-lock)?\\.json", "dest": "/api/blocked", "status": 404 },
    { "src": "/vercel\\.json", "dest": "/api/blocked", "status": 404 },
    { "src": "/\\..*", "dest": "/api/blocked", "status": 404 },
    { "src": "/(br-loc-desk|hero-loc-desk)\\.png", "dest": "/api/blocked", "status": 404 }
  ]
}
